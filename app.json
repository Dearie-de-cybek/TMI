{
  "expo": {
    "name": "Kingdom Heralds",
    "slug": "kingdom-heralds",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kingdomheralds",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.kingdomheralds.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.kingdomheralds.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kingdom Heralds uses your photos so you can set a profile picture.",
          "cameraPermission": "Kingdom Heralds uses your camera so you can take a profile picture."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Kingdom Heralds adds church events to your calendar when you ask it to."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F4A3C",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F3EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 84,
          "dark": {
            "backgroundColor": "#15150F"
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {}
    }
  }
}

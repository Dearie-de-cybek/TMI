# ---------------------------------------------------------------------------
# Kingdom Heralds mobile app — environment configuration
#
# Copy to `.env` (development), `.env.staging` or `.env.production`.
# Only EXPO_PUBLIC_* values are readable by the app bundle, so NOTHING secret
# belongs in this file. Payment keys, AI provider keys, database credentials
# and messaging credentials live on the Laravel backend only.
# ---------------------------------------------------------------------------

# "demo" runs the app against the bundled development data provider.
# "live" talks to the Laravel API at EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_API_MODE=live

# Base URL of the Laravel API, including the version prefix.
EXPO_PUBLIC_API_URL=https://twainmanministry.org/api/v1

# Request timeout in milliseconds.
EXPO_PUBLIC_API_TIMEOUT=15000

# Allows switching between demo and live data from Profile → Settings → Developer.
# Keep this 0 for production builds.
EXPO_PUBLIC_ALLOW_MODE_SWITCH=1

# Church contact details rendered in the Help / pastoral care screens.
EXPO_PUBLIC_CHURCH_EMAIL=hello@twainmanministry.org
EXPO_PUBLIC_CHURCH_PHONE=+2348000000000
EXPO_PUBLIC_PRIVACY_URL=https://twainmanministry.org/privacy
EXPO_PUBLIC_TERMS_URL=https://twainmanministry.org/terms
